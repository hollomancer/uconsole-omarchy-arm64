package() {
  local upstream="$srcdir/omarchy-${_commit}"
  local destination="$pkgdir/usr/share/omarchy-arm64"
  local command_name=''
  local visibility=''
  local reason=''
  local command_source=''

  install -d "$destination/bin" "$destination/config/omarchy" "$destination/default/omarchy"
  cp -a "$upstream/shell" "$destination/shell"
  cp -a "$upstream/themes" "$destination/themes"
  install -m 0644 "$upstream/default/omarchy/launcher.hides" "$destination/default/omarchy/launcher.hides"
  install -m 0644 "$srcdir/omarchy-menu.jsonc" "$destination/default/omarchy/omarchy-menu.jsonc"
  install -m 0644 "$srcdir/shell.json" "$destination/config/omarchy/shell.json"

  while IFS='|' read -r command_name visibility reason; do
    [[ -n "$command_name" && "$command_name" != \#* ]] || continue
    case "$visibility" in internal|expose) ;; *) return 1 ;; esac
    command_source="$upstream/bin/$command_name"
    case "$command_name" in
      omarchy-audio-tuning|omarchy-dns|omarchy-launch-floating-terminal-with-presentation|omarchy-remove-launcher-entry|omarchy-theme-bg-set|omarchy-theme-bg-switcher|omarchy-theme-set|omarchy-theme-switcher)
        command_source="$srcdir/$command_name"
        ;;
    esac
    [[ -f "$command_source" ]] || return 1
    install -m 0755 "$command_source" "$destination/bin/$command_name"
  done < "$srcdir/omarchy-command-policy.tsv"

  install -Dm0755 "$srcdir/omarchy-launch-shell-arm64" "$pkgdir/usr/bin/omarchy-launch-shell"
  install -Dm0755 "$srcdir/omarchy-shell-arm64" "$pkgdir/usr/bin/omarchy-shell"
  install -Dm0755 "$srcdir/omarchy-menu-arm64" "$pkgdir/usr/bin/omarchy-menu"

  install -Dm0644 "$upstream/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "$srcdir/omarchy-command-policy.tsv" "$pkgdir/usr/share/doc/$pkgname/omarchy-command-policy.tsv"
  install -Dm0644 "$srcdir/omarchy-plugin-policy.tsv" "$pkgdir/usr/share/doc/$pkgname/omarchy-plugin-policy.tsv"
  printf '%s\n' \
    "upstream_commit=${_commit}" \
    'activation=not-enabled' \
    'home_seeded=no' \
    'hyprland_owned=no' \
    'updates_owned=no' \
    'hardware_owned=no' \
    > "$destination/ARM64-PACKAGE-STATE"
}
