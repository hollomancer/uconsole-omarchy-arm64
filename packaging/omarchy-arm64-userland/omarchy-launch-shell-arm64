#!/usr/bin/env bash

# Keep Omarchy's reviewed internal helpers available only to the shell process
# tree. They are intentionally not installed into the system-wide PATH.
set -u
OMARCHY_PATH=/usr/share/omarchy-arm64
export OMARCHY_PATH
PATH="$OMARCHY_PATH/bin:$PATH"
export PATH
exec "$OMARCHY_PATH/bin/omarchy-launch-shell" "$@"
