# Adapted from omacom-io/omarchy-pkgs at commit
# 40ddd6be195a704c1e4187fc7ecd3f2c8091e37b (MIT repository license).

pkgname=omacut
pkgver=0.4.0
pkgrel=2
pkgdesc='Dead-simple video length trimmer built with Qt Quick and ffmpeg'
arch=('aarch64')
url='https://github.com/omacom-io/omacut'
license=('MIT')
install='omacut.install'
options=('!debug')
depends=('desktop-file-utils' 'ffmpeg' 'gtk-update-icon-cache'
         'hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-multimedia'
         'qt6-multimedia-ffmpeg' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-multimedia')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0e1b0665e0304a1ecbdb06b8574e8abf385e1cffa431821032902340c2c5d7df')

build() {
  cd "$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/omacut "$pkgdir/usr/bin/omacut"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omacut.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omacut.svg"
  install -Dm644 pkgbuild/omacut.desktop "$pkgdir/usr/share/applications/omacut.desktop"
}
